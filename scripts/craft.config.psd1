# craft.config.psd1 - per-repo settings for start.ps1 and scripts\release.ps1.
# Generated by mcp-central-docs\scripts\sync-craft-scaffold.ps1, then owned by this repo:
# edit freely, sync never overwrites it. Standard: standards\rust-artcraft\CRAFT_START_AND_RELEASE.md
# Smoke arguments: {db} becomes a throwaway database path. Empty list = no such smoke.
@{
    Name        = 'tethercraft'
    Display     = 'TetherCraft'
    AppPackage  = 'tethercraft-app'
    AppBin      = 'tethercraft'
    AppSmoke    = @()
    CliPackage  = 'tethercraft-app'
    CliBin      = 'tethercraft'
    CliSmoke    = @('status')
    McpPackage  = 'tethercraft-mcp'
    McpBin      = 'tethercraft-mcp'
    McpSmoke    = @()
    Installer   = $true
    Mcpb        = $false
    # Floor off: the Tier 3 workstation chrome (menu bar, chat dock, skins,
    # asset manifest) is not built yet. Smoke still builds both binaries and
    # runs the CLI status check.
    Floor       = $false
}
